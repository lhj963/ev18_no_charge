--cpu Cortex-M3
".\output\main.o"
".\output\apps.o"
".\output\startup.o"
".\output\sysapi.o"
--library_type=microlib --strict --scatter ".\output\KeilMDK.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list ".\lst\KeilMDK.map" -o .\output\KeilMDK.axf